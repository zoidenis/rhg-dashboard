# ---- Business Central connection ----
# Same OData address your rhg-business-central MCP server uses (see C:\bc-mcp config)
BC_BASE_URL=http://92.205.182.52:8348/RHG/ODataV4
BC_USERNAME=YOUR_BC_USER
# For BC "NavUserPassword" logins use the user's Web Service Access Key here.
# For Windows logins set BC_AUTH_MODE=ntlm and use the Windows password (DOMAIN\user as username).
BC_PASSWORD=YOUR_WEB_SERVICE_ACCESS_KEY
BC_AUTH_MODE=basic
BC_COMPANY=SALT

# ---- App ----
APP_HOST=127.0.0.1
APP_PORT=8765
REFRESH_SECONDS=30

# ---- Analysis thresholds (ALL, ex-VAT) ----
INCLUDE_EXPECTED_COST=true
MIN_SPEND_FOR_MOVER=5000
MIN_PCT_FOR_MOVER=3
PRICE_ALERT_PCT=25
EXCEPTION_SPEND=100000
LOCATION_SPREAD_PCT=20

# ---- Invoices, users, requisitions ----
BC_VENDOR_ENTITY=VendorLedgerEntries
BC_PO_ENTITY=PurchaseOrderList
# Publish standard page "Item Registers" as web service ItemRegisters to see which user posted what
BC_REGISTER_ENTITY=ItemRegisters
# Publish the "Req. Worksheet" page as web service RequisitionLines to enable the Requisitions screen
BC_REQ_ENTITY=RequisitionLines
LATE_POSTING_DAYS=7
