APP_HOST=127.0.0.1
APP_PORT=8767
SESSION_HOURS=12
IDLE_MINUTES=60
MAX_FAILURES=5
LOCK_MINUTES=15
MIN_PASSWORD=12
COOKIE_SECURE=true
# Shared secret the control towers use to validate sessions. Generate with:
#   openssl rand -hex 32
SERVICE_TOKEN=CHANGE_ME

# Unicorn, the business analyst of pulse (morning brief and chat for management).
# Without a key Unicorn stays off. The key belongs on the server only; never commit it.
ANTHROPIC_API_KEY=
UNICORN_MODEL=claude-sonnet-5-5
UNICORN_TIME=08:00
UNICORN_LANGUAGE=Albanian
FINANCE_URL=http://finance:8766
PURCHASING_URL=http://purchasing:8765
UNICORN_EFFORT=medium
UNICORN_BRIEF_TOKENS=16000
UNICORN_CHAT_TOKENS=8000
