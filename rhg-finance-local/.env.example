# ---- Business Central (read-only) ----
BC_BASE_URL=http://92.205.182.52:8348/RHG/ODataV4
BC_USERNAME=YOUR_BC_USER
BC_PASSWORD=YOUR_WEB_SERVICE_ACCESS_KEY
BC_AUTH_MODE=basic
BC_COMPANY=SALT

# ---- App ----
APP_HOST=127.0.0.1
APP_PORT=8766
REFRESH_SECONDS=120
CURRENCY=ALL

# ---- Entity names as published in BC (change only if yours differ) ----
E_ACCOUNTS=Chart_of_Accounts
E_GL=G_LEntries
E_BUDGET=G_LBudgetEntries
E_VENDOR=VendorLedgerEntries
E_CUSTOMER=Cust_LedgerEntries
E_BANK=BankAccountLedgerEntries
E_ITEM_LEDGER=ItemLedgerEntries
E_FA=FALedgerEntries
E_DIMSET=DimensionSetEntries
E_FINREPORT=pbfinance

# ---- Fiscalized purchase invoices (Tax Administration e-invoice service, reading only) ----
# The certificate stays on the server: /opt/rhg/secrets/fisk.p12, mounted read-only at /app/secrets.
FISK_CERT_PATH=/app/secrets/fisk.p12
FISK_CERT_PASSWORD=
FISK_NIPT=L91520027A
# BC company that holds this NIPT's purchase invoices (blank = BC_COMPANY)
FISK_COMPANY=SALT
# From the "Einvoice Service - Technical" specification; blank = the service is not called
FISK_EINVOICE_URL=
FISK_SOAP_ACTION=
FISK_PARTY_TYPE=BUYER
FISK_WINDOW_DAYS=7
